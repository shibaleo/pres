{
  // ビルド側(Vite プラグイン・設定・テスト)の型チェック。ブラウザ側は tsconfig.json
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": ["vite", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
